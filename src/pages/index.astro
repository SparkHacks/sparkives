---
import Layout from "../layouts/Layout.astro";
import InfoWindow from "../components/info/InfoWindow.astro";
import InternetWindow from "../components/internet/InternetWindow.astro";
import Window from "../components/Window.astro";
import Dock from "../components/Dock.astro";
import Team from "../components/Team.astro";
import { sh24Data } from "../data/sh24Data";
import { sh25Data } from "../data/sh25Data";
import { sh26Data } from "../data/sh26Data";
import { teamWindowConfig } from "../data/teamWindowConfig";
import { Banana, Folder } from "@lucide/astro";
import YearGrid from "../components/YearGrid.astro";
import { icons } from "../assets/svgBank";

const dockItems = [
	{ id: "win-finder", label: "Finder", icon: "computer" },
	{ id: "", label: "Mail", icon: "mail" },
	{ id: "complete-overview", label: "Internet", icon: "internet" },
	{ id: "", label: "Trash", icon: "trash" },
] as const;

const yearTeamWindows = [
	{ year: 2024, id: "win-2024", data: sh24Data, teams: teamWindowConfig[2024], x: 160, y: 200 },
	{ year: 2025, id: "win-2025", data: sh25Data, teams: teamWindowConfig[2025], x: 220, y: 260 },
	{ year: 2026, id: "win-2026", data: sh26Data, teams: teamWindowConfig[2026], x: 280, y: 320 },
];

const numRows = 6;
const iconsPerRow = 20;
---

<Layout title="Sparkives">

	<div class="select-none flex flex-col items-end">
		<h1 class="font-sans text-6xl font-black">Sparkhacks Archive</h1>
		<p class="font-dot text-2xl">Walk through our past!</p>
	</div>

	<!-- SCROLLING BACKGROUND -->
	<div class="select-none bg-scroll-container">
		{Array.from({ length: numRows }).map((_, rowIndex) => (
			<div class={`bg-scroll-row ${rowIndex % 2 === 0 ? "scroll-left" : "scroll-right"}`}>
				<div class="bg-scroll-track">
					{Array.from({ length: iconsPerRow * 2 }).map(() => (
						<span class="bg-scroll-icon" set:html={icons.backgroundText} />
					))}
				</div>
			</div>
		))}
	</div>

	<!-- ---------------- WINDOWS ------------------ -->	
	<Window id="win-finder" title="Past Years Archive" initialX={120} initialY={160} open={true} headerColor="yellow" width="400px">
		<YearGrid />
	</Window>

	{yearTeamWindows.map((yearWindow) => (
		<Window
			id={yearWindow.id}
			title={`${yearWindow.year} Team Archive`}
			initialX={yearWindow.x}
			initialY={yearWindow.y}
			open={false}
			headerColor="green"
		>
			<div class="space-y-3">
				<p>{yearWindow.data.name}</p>
				<div class="flex flex-wrap gap-2">
					{yearWindow.teams.map((team) => (
						<button
							data-open={team.id}
							type="button"
							class="cursor-pointer rounded-md border-2 border-primary bg-[#F8E9C3] px-3 py-1 font-dot text-primary shadow-solid transition hover:-translate-y-0.5"
						>
							{team.label}
						</button>
					))}
				</div>
			</div>
		</Window>
	))}

	{yearTeamWindows.flatMap((yearWindow) =>
		yearWindow.teams.map((team) => (
			<Window
				id={team.id}
				title={team.title}
				initialX={team.x}
				initialY={team.y}
				open={false}
				headerColor={team.color}
				width={team.width}
			>
				<Team title={team.title} members={yearWindow.data.team[team.teamKey]} />
			</Window>
		))
	)}

	<Dock items={[...dockItems]} />
</Layout>

<style>
	.bg-scroll-container {
		position: fixed;
		inset: 0;
		overflow: hidden;
		transform: rotate(-9deg) scale(1.3);
		z-index: -1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 100px;
		pointer-events: none;
		background: linear-gradient(0deg, #7DBBFD 0%, #BDE5E7 87%);
	}

	.bg-scroll-row {
		display: flex;
		min-width: 0;
	}

	.bg-scroll-track {
		display: flex;
		gap: 100px;
		will-change: transform;
		white-space: nowrap;
	}

	.bg-scroll-icon {
		display: inline-flex;
		flex-shrink: 0;
	}

	.scroll-left .bg-scroll-track {
		animation: scrollLeft 260s linear infinite;
	}

	.scroll-right .bg-scroll-track {
		animation: scrollRight 260s linear infinite;
	}

	@keyframes scrollLeft {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@keyframes scrollRight {
		from { transform: translateX(-50%); }
		to { transform: translateX(0); }
	}

</style>
