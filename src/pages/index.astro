---
import Layout from "../layouts/Layout.astro";
import InfoWindow from "../components/info/InfoWindow.astro";
import InternetWindow from "../components/internet/InternetWindow.astro";
import Window from "../components/Window.astro";
import Dock from "../components/Dock.astro";
import Team from "../components/info/Team.astro";
import Winners from "../components/info/Winners.astro";
import { sh23Data } from "../data/sh23Data";
import { sh24Data } from "../data/sh24Data";
import { sh25Data } from "../data/sh25Data";
import { sh26Data } from "../data/sh26Data";
import { teamWindowConfig } from "../data/teamWindowConfig";
import YearGrid from "../components/YearGrid.astro";
import { icons } from "../assets/svgBank";

const dockItems = [
	{ id: "win-finder", label: "Finder", icon: "computer" },
	{ id: "", label: "Mail", icon: "mail" },
	{ id: "complete-overview", label: "Internet", icon: "internet" },
	{ id: "", label: "Settings", icon: "settings" },
	{ id: "", label: "Trash", icon: "trash" },
] as const;

const yearWindows = [
	{ year: 2023, id: "win-2023", data: sh23Data, teams: teamWindowConfig[2023], x: 100, y: 140, color:"indigo" },
	{ year: 2024, id: "win-2024", data: sh24Data, teams: teamWindowConfig[2024], x: 160, y: 200, color:"violet" },
	{ year: 2025, id: "win-2025", data: sh25Data, teams: teamWindowConfig[2025], x: 220, y: 260, color:"cyan" },
	{ year: 2026, id: "win-2026", data: sh26Data, teams: teamWindowConfig[2026], x: 280, y: 320, color:"rose" },
];

const numRows = 6;
const iconsPerRow = 20;
---
<Layout title="Sparkives">

	<div class="select-none flex flex-col items-end">
		<h1 class="font-sans text-6xl font-black">Sparkhacks Archive</h1>
		<p class="font-dot text-2xl">Walk through our past!</p>
	</div>

	<!-- SCROLLING BACKGROUND -->
	<div class="select-none bg-scroll-container">
		{Array.from({ length: numRows }).map((_, rowIndex) => (
			<div class={`bg-scroll-row ${rowIndex % 2 === 0 ? "scroll-left" : "scroll-right"}`}>
				<div class="bg-scroll-track">
					{Array.from({ length: iconsPerRow * 2 }).map(() => (
						<span class="bg-scroll-icon" set:html={icons.backgroundText} />
					))}
				</div>
			</div>
		))}
	</div>

	<!-- ---------------- WINDOWS ------------------ -->	
	<Window id="complete-overview" title="About SparkHacks" initialX={360} initialY={120} open={true} headerColor="sky" width="720px" customWindow="internet">
		<InternetWindow />
	</Window>

	
	<Window id="win-finder" title="Past Years Archive" initialX={100} initialY={340} open={true} headerColor="yellow" width="400px">
		<YearGrid />
	</Window>
	
	{
		yearWindows.map((yearWind, i) => (
			<Window id={`winners-${yearWind.year}`} title={`${yearWind.year} Winners`} initialX={300+(50*i)} initialY={100+(50*i)} open={false} headerColor={yearWind.color} width="800px" customBG="Winners">
				<Winners year={yearWind.year} />
			</Window>
		))
	}
	
	{yearWindows.map((yearWindow) => (
		<Window
			id={yearWindow.id}
			title={`SparkHacks ${yearWindow.year} Info`}
			initialX={yearWindow.x}
			initialY={yearWindow.y}
			headerColor={yearWindow.color}
			open={false}
			width="720px"
		>
			<InfoWindow
				id={yearWindow.id}
			/>
		</Window>
	))}

	{yearWindows.flatMap((yearWindow) =>
		yearWindow.teams.map((team) => (
			<Window
				id={team.id}
				title={team.title}
				initialX={team.x}
				initialY={team.y}
				open={false}
				headerColor={team.color}
				width={team.width}
			>
				<Team title={team.title} members={yearWindow.data.team[team.teamKey]} />
			</Window>
		))
	)}

	<Dock items={[...dockItems]} />
</Layout>

<!-- gradients -->
<svg class="absolute w-0 h-0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="red-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#fca5a5" />
		<stop offset="95%" stop-color="#fee2e2" />
    </linearGradient>
	
    <linearGradient id="orange-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#fdba74" />
		<stop offset="95%" stop-color="#ffedd5" />
    </linearGradient>
	
    <linearGradient id="yellow-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#F8DA94" />
		<stop offset="95%" stop-color="#F8E9C3" />
    </linearGradient>
	
    <linearGradient id="green-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#86efac" />
		<stop offset="95%" stop-color="#dcfce7" />
    </linearGradient>
	
    <linearGradient id="blue-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#93c5fd" />
		<stop offset="95%" stop-color="#dbeafe" />
    </linearGradient>
	
    <linearGradient id="purple-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#d8b4fe" />
		<stop offset="95%" stop-color="#f3e8ff" />
    </linearGradient>

    <linearGradient id="pink-gradient" gradientTransform="rotate(90)">
		<stop offset="5%" stop-color="#f0abfc" />
		<stop offset="95%" stop-color="#fce7f3" />
    </linearGradient>
	
  </defs>
</svg>

<style>
	.bg-scroll-container {
		position: fixed;
		inset: 0;
		overflow: hidden;
		transform: rotate(-9deg) scale(1.3);
		z-index: -1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 100px;
		pointer-events: none;
		background: linear-gradient(0deg, #7DBBFD 0%, #BDE5E7 87%);
	}

	.bg-scroll-row {
		display: flex;
		min-width: 0;
	}

	.bg-scroll-track {
		display: flex;
		gap: 100px;
		will-change: transform;
		white-space: nowrap;
	}

	.bg-scroll-icon {
		display: inline-flex;
		flex-shrink: 0;
	}

	.scroll-left .bg-scroll-track {
		animation: scrollLeft 260s linear infinite;
	}

	.scroll-right .bg-scroll-track {
		animation: scrollRight 260s linear infinite;
	}

	@keyframes scrollLeft {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@keyframes scrollRight {
		from { transform: translateX(-50%); }
		to { transform: translateX(0); }
	}

</style>
