---
import Layout from "../layouts/Layout.astro";
import Window from "../components/Window.astro";
import Dock from "../components/Dock.astro";
import { Banana, Folder } from "@lucide/astro";
import YearGrid from "../components/YearGrid.astro";

const dockItems = [
	{ id: "win-finder", label: "Finder", icon: "computer" },
	{ id: "", label: "Mail", icon: "mail" },
	{ id: "", label: "Internet", icon: "internet" },
	{ id: "", label: "Trash", icon: "trash" },
] as const;
---

<Layout title="Sparkives">
	<header class="mb-8 flex items-center gap-3">
		<Banana class="text-yellow-400" size={32} />
		<h1 class="text-3xl font-bold font-dot">Sparkives</h1>
	</header>

	<!-- WINDOWS -->
	<Window id="win-finder" title="Past Years Archive" initialX={120} initialY={160} open={true} headerColor="sky" width="400px">
		<YearGrid />
	</Window>

	<Window id="win-2025" title="Past Years Archive" initialX={220} initialY={260} open={false} headerColor="green">
		<p>2025</p>
	</Window>

	<Dock items={dockItems} />
</Layout>
