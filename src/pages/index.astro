---
import Layout from "../layouts/Layout.astro";
import Window from "../components/Window.astro";
import { Banana } from "@lucide/astro";
---

<Layout title="Sparkives">
	<header class="mb-8 flex items-center gap-3">
		<Banana class="text-yellow-400" size={32} />
		<h1 class="text-3xl font-bold font-dot">Sparkives</h1>
	</header>

	<button data-open="Window-1" class="border-2 border-primary text-primary font-dot px-3 py-1 rounded-md shadow-solid mr-10">Open Window 1</button>

	<button data-open="Window-2" class="border-2 border-primary text-primary font-dot px-3 py-1 rounded-md shadow-solid">Open Window 2</button>

	<Window id="Window-1" title="Hello" initialX={120} initialY={160} open={false} headerColor="purple">
		<p>Example Content 1.</p>
		<button data-open="Window-11" class="border-2 border-primary text-primary bg-white font-dot text-sm px-2 py-1 rounded-md shadow-solid self-start">
			Open Inner Window
		</button>
	</Window>

	<Window id="Window-11" title="Window 2" initialX={300} initialY={220} open={false} headerColor="green" defaultZLayer={19}>
		<p class="text-sm font-dot">Opened from Window 1!</p>
	</Window>

	<Window id="Window-2" title="Window 2" initialX={400} initialY={280} open={false} headerColor="red">
		<p class="text-sm font-dot">Window 2!</p>
	</Window>
</Layout>

<script>
	for (const btn of document.querySelectorAll<HTMLElement>("[data-open]")) {
		btn.addEventListener("click", () => {
			const id = btn.dataset.open!;
			const win = document.getElementById(id);
			if (win) win.style.display = "block";
		});
	}
</script>
