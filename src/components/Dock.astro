---
import { icons } from "../assets/svgBank"

interface DockItem {
  id?: string
  label: string
  icon: keyof typeof icons
  shadowColor?: string
}

interface Props {
  items: DockItem[]
}

const { items } = Astro.props
---

<div class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 select-none" style="width:520px;">
  <div class="absolute bottom-0 left-0 w-full pointer-events-none [&>svg]:w-full [&>svg]:h-auto" set:html={icons.dockPad} />

  <div class="absolute left-0 w-full flex items-end justify-center gap-6 px-8" style="bottom: 15px;">
    {items.map((item) => (
      <button
        data-open={item.id ?? ""}
        class="dock-btn group relative flex flex-col items-center justify-center"
        title={item.label}
      >
        <span class="pointer-events-none absolute -top-11 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md border-2 border-primary bg-window-bg px-2 py-0.5 text-md font-dot text-primary opacity-0 shadow-solid transition-opacity duration-150 group-hover:opacity-100">
          {item.label}
        </span>
        <span
          class="dock-icon transition-all duration-200 ease-out group-hover:scale-110 group-hover:-translate-y-2"
          style="filter: drop-shadow(2px 4px 0px black)"
          set:html={icons[item.icon]}
        />
      </button>
    ))}
  </div>
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>(".dock-btn, .folder-btn, .team-btn, .winner-btn")) {
    const id = btn.dataset.open;
    if (!id) continue;
    const win = document.getElementById(id);
    if (!win) continue;

    btn.addEventListener("click", () => {
      if (win.style.display === "none") {
        win.style.display = "block";
      } else {
        win.classList.add("dock-bounce");
        win.addEventListener("animationend", () => win.classList.remove("dock-bounce"), { once: true });
        win.dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
      }
    });
    
  }
  
  // close all windows
  const trash_btn = document.querySelector('button[title="Trash"]');
  trash_btn?.addEventListener("click", () => {
    for (const wind of document.querySelectorAll<HTMLElement>(".window"))   {
      wind.style.display = "none";
    }
  });
</script>

<style>
  .dock-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  @keyframes dock-bounce {
    0%   { transform: translateY(0); }
    30%  { transform: translateY(-12px); }
    60%  { transform: translateY(4px); }
    80%  { transform: translateY(-4px); }
    100% { transform: translateY(0); }
  }
  :global(.dock-bounce) {
    animation: dock-bounce 0.4s ease;
  }

  .dock-icon :global(svg) {
    width: 75px;
    height: 75px;
  }
</style>
