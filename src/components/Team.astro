---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Member {
  name: string;
  role: string;
  photo?: string;
  linkedin?: string;
}
interface Props {
  title: string;
  members: Member[];
}
const { title, members } = Astro.props;

const photoMap = {
  ...import.meta.glob("../assets/sh-25/*.webp", { eager: true, import: "default" }),
  ...import.meta.glob("../assets/sh-26/*.webp", { eager: true, import: "default" }),
} as Record<string, ImageMetadata>;
---

<section class="team-window">
  <h2>{title}</h2>
  <div class="team-grid">
    {members.map((m) => {
      const photoSrc = photoMap[`../assets/${m.photo}`];

      return (
        <article class="team-card">
            <Image
              src={photoSrc}
              alt={`${m.name} portrait`}
              width={108}
              height={108}
              loading="lazy"
              class="team-avatar"
            />
          <p>{m.name}</p>
          <p>{m.role}</p>
        </article>
      );
    })}
  </div>
</section>

<style>
  .team-window {
    width: 100%;
    padding: 0.25rem 0.25rem 0.75rem;
  }

  .team-window h2 {
    margin-bottom: 1.25rem;
    text-align: center;
    font-family: "Fredoka", sans-serif;
    font-size: clamp(1.5rem, 2.2vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .team-avatar {
    height: 108px;
    width: 108px;
    object-fit: cover;
    border: 4px solid #000;
    border-radius: 1.1rem;
    background: #c7c7c9;
  }

  .team-card p {
    font-size: clamp(1.15rem, 1.8vw, 1.75rem);
    line-height: 1.1;
    text-align: center;
  }

  @media (max-width: 960px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>