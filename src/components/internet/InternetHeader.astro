---
import { X } from "@lucide/astro";

interface Props {
  title?: string;
}

const { title = "Internet"} = Astro.props;
---

<div class={`select-none window-titlebar flex items-center justify-between border-b-[3px] border-primary bg-linear-0 from-blue-100 to-blue-300 px-3 py-2 cursor-grab`}>
    <span class="text-primary flex-1">{title}</span>
    <button class="window-close text-primary cursor-pointer">
      <X stroke-width="4px"/>
    </button>
</div>