---
import About from "./About.astro";
import FAQ from "./FAQ.astro";
import Apply from "./Apply.astro";

const tabs = ["About", "FAQ", "Apply"];
---

<div id="internet-window" class="select-none bg-transparent">
	<!-- Tabs -->
	<div id="" class="flex flex-row gap-2 mb-[-6px]">
		{Array.from(tabs).map((tab) => (
			<svg id={tab.toLowerCase()} class="tab cursor-pointer" 
				width="84" height="36" viewBox="0 0 84 36" fill="#bae6fd" xmlns="http://www.w3.org/2000/svg">
				<path d="M3.13634 33.5H80.7441L74.3352 5.47872C73.6678 3.69149 72.6717 2.5 70.1814 2.5H13.6988C11.2085 2.5 10.2124 3.69149 9.54507 5.47872L3.13634 33.5Z"
					stroke="black" stroke-width="5"
					stroke-dasharray="0 77.75 55" />
				<text x="50%" y="70%" text-anchor="middle" fill="black">{tab.toUpperCase()}</text>				
			</svg>
		))}
	</div>

	<!-- Content view -->
	<div class="border-[3px] border-primary absolute left-0 right-0" />
	
	<div id="about-page" class="p-4 content hidden">
		<About />
	</div>
	<div id="faq-page" class="p-4 content hidden">
		<FAQ />
	</div>
	<div id="apply-page" class="p-4 content hidden">
		<Apply />
	</div>
</div>


<script>
	const tabs = document.querySelectorAll(".tab");
	const contents = document.querySelectorAll(".content"); 

	// make default tab active
	document.addEventListener("DOMContentLoaded", () => {
		document.querySelector("#about")?.classList.add("tab-active");
		document.querySelector("#about-page")?.classList.add("content-active");
	}) 

	tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
		// change tab appearance
        tabs.forEach(t => t.classList.remove("tab-active"));
        
        tab.classList.add("tab-active");

		// change content
		contents.forEach(c => c.classList.remove("content-active"));
        
		var content_obj = document.getElementById(tab.id + "-page"); 
		content_obj?.classList.add("content-active");
      });
    });

</script>


<style>
	.tab-active {
		/* background: #FDF8DD; */
		transform: scale(1.15);
		fill: #FDF6DA;
		z-index: 100;
	}

	.content-active {
		display: block;
	}
</style>