---
import { Image, Picture } from "astro:assets";
import gathers24 from "../../assets/imgs/sh24_gathers.webp"
import selfie25 from "../../assets/imgs/sh25_selfie.webp"
import polaroid25 from "../../assets/imgs/sh25_polaroid.webp"
import panIQ26 from "../../assets/imgs/sh26_paniq.webp"
import sparkyImage from "../../assets/easter-eggs/sparky.webp";

const sparkSagas = [
    {
        "quote": "I spent more time on sparkhacks than I did on my tech electives in 2024 and I have no regrets. Being a part of the team taught me lessons and skills I'd have never found in a classroom. It's my most cherished memories at uic and a legacy I will carry with me forever. was I drunk with power? probably (not)",
        "image": "sh-24/naan.webp",
        "person": "Nandana Sheri",
        "role": "Director 2024"
    },
    {
        "quote": "It was so fun being a part of the board and seeing all our designs come to life at the hackathon!! I loved being able to get creative with all of the designs from the merch to the insta posts. My fav moment was the board photoshoot we organized together!",
        "image": "sh-26/huda.webp",
        "person": "Huda Syed",
        "role": "Outreach 2026"
    },
    {
        "quote": "i was on the board for 3 years. was that longer than anyone should? definitely. would i do it again, probably. Sparkhacks was such a fun, loving community that really rounded my college experience",
        "image": "sh-26/kaustubha.webp",
        "person": "Kaustubha Medikundam",
        "role": "Communications 2026"
    },
    {
        "quote": "goated",
        "image": "sh-26/stanley.webp",
        "person": "Stanley Huang",
        "role": "Logistics 2026"
    },
    {
        "quote": "Hallo",
        "image": "sh-26/kaito.webp",
        "person": "Kaito Sekiya",
        "role": "Director 2026"
    },
    // add more quotes here!
]

const photoMap = {
  ...import.meta.glob("../../assets/easter-eggs/*.webp", { eager: true, import: "default" }),
  ...import.meta.glob("../../assets/sh-23/*.webp", { eager: true, import: "default" }),
  ...import.meta.glob("../../assets/sh-24/*.webp", { eager: true, import: "default" }),
  ...import.meta.glob("../../assets/sh-25/*.webp", { eager: true, import: "default" }),
  ...import.meta.glob("../../assets/sh-26/*.webp", { eager: true, import: "default" }),
} as Record<string, ImageMetadata>;
---

<div class="flex flex-col gap-4" style="text-wrap: pretty; ">
    <h2 class="font-sans text-3xl font-black">SAGAS FROM THE SPARKHACKS BOARD</h2>

    <div class="h-100 overflow-y-scroll flex flex-col gap-6 py-4 justify-around" style="scrollbar-color: gray #ffffff00;">
        { Array.from(sparkSagas).map((item, i) => (
            <div class="flex flex-row bg-cyan-100 border-black border-2 gap-3 p-4">
                <div class="flex flex-col text-center w-24">
                    <div class= "h-24 w-24">
                        <Image
                            src={photoMap[`../../assets/${item.image}`]}
                            alt={`${item.person}`}
                            width={200}
                            height={200}
                            loading="lazy"
                            class="saga-image border-black border-2 transition-all duration-200 ease-out hover:scale-110"
                            // style="width: 100%; height: 100%"
                        />
                    </div>
                
                    <p>{item["person"]}</p>
                    <p class="text-sm">{item["role"]}</p>
                </div>

                <div class="p-2 bg-cyan-50 border" style="height: fit-content">
                    {item["quote"]}
                </div>
            </div>
        ))}

        <!-- pictures -->
        <hr class="mt-4" />
        <p class="text-2xl font-extrabold">Memories 💖</p>
        
        <div class="text-right">
            <Picture src={panIQ26} alt="Escaping PanIQ with 2026 E-Board!" class="border-4 border-primary rounded-xl" />
            <p>Escaping PanIQ with 2026 E-Board!</p>
        </div>

        <div class="text-right">
            <div class="flex gap-2">
                <Picture src={polaroid25} alt="Selfies with 2025 E-Board!" class="border-4 border-primary rounded-xl" />
                <div class="flex flex-col">
                    <Picture src={selfie25} alt="Selfies with 2025 E-Board!" class="border-4 border-primary rounded-xl" />
                    <p>Selfies with 2025 E-Board!</p>
                </div>
            </div>
        </div>
        
        <div class="text-right">
            <Picture src={gathers24} alt="Enjoying some Gathers with 2024 E-Board!" class="border-4 border-primary rounded-xl" />
            <p>Enjoying some Gathers with 2024 E-Board!</p>
        </div>

        <div class="text-right">
            <Picture src={sparkyImage} alt="Sparky the Dragon." class="border-4 border-primary rounded-xl" />
            <p>Honorary Sparky mention!</p>
        </div>
    </div>
</div>

<style>
    .saga-image {
        object-fit: cover;
    }
</style>