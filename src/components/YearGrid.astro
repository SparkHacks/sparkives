---
const years = [
  { year: 2025, win: "win-2025", color: "#f87171" },
  { year: 2026, win: "win-2026", color: "#49cedd" },
]

const closedPath = "M55 52.0833C56.5471 52.0833 58.0308 51.4688 59.1248 50.3748C60.2188 49.2808 60.8333 47.7971 60.8333 46.25V17.0833C60.8333 15.5362 60.2188 14.0525 59.1248 12.9585C58.0308 11.8646 56.5471 11.25 55 11.25H31.9583C30.9827 11.2596 30.0203 11.0243 29.1592 10.5657C28.2981 10.1071 27.5657 9.43984 27.0292 8.625L24.6667 5.125C24.1355 4.31845 23.4124 3.6564 22.5623 3.19824C21.7122 2.74008 20.7616 2.50016 19.7958 2.5H8.33333C6.78624 2.5 5.30251 3.11458 4.20854 4.20854C3.11458 5.30251 2.5 6.78624 2.5 8.33333V46.25C2.5 47.7971 3.11458 49.2808 4.20854 50.3748C5.30251 51.4688 6.78624 52.0833 8.33333 52.0833H55Z"
const openPath = "M66 44.0833C67.5471 44.0833 69.0308 43.4688 70.1248 42.3748C71.2188 41.2808 71.8333 39.7971 71.8333 38.25L60.8333 17.0833C60.1667 15.75 59.1667 13.75 58.1667 12.75C57.1667 11.75 56.1667 11.25 55 11.25H31.9583C30.9827 11.2596 30.0203 11.0243 29.1592 10.5657C28.2981 10.1071 27.5657 9.43984 27.0292 8.625L24.6667 5.125C24.1355 4.31845 23.4124 3.6564 22.5623 3.19824C21.7122 2.74008 20.7616 2.50016 19.7958 2.5H8.33333C6.78624 2.5 5.30251 3.11458 4.20854 4.20854C3.11458 5.30251 2.5 6.78624 2.5 8.33333L13.5 38.25C13.5 39.7971 14.1146 41.2808 15.2085 42.3748C16.3025 43.4688 17.7862 44.0833 19.3333 44.0833H66Z"
---

<div class="grid grid-cols-4 gap-8 px-4">
  {years.map(({ year, win, color }) => (
    <button data-open={win} class="folder-btn flex flex-col items-center justify-center gap-1">

      <!-- Fixed-size container so swapping icons never shifts layout -->
      <div class="relative" style="width:75px; height:55px;">

        <!-- Closed folder (shown by default) -->
        <div class="folder-closed absolute inset-0 flex items-center justify-center cursor-pointer" style="filter: drop-shadow(2px 4px 0px black)">
          <svg width="64" height="55" viewBox="0 0 64 55" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id={`grad-${year}`} x1="31.6667" y1="2.5" x2="31.6667" y2="52.0833" gradientUnits="userSpaceOnUse">
                <stop stop-color={color}/>
                <stop offset="1" stop-color="white"/>
              </linearGradient>
            </defs>
            <path d={closedPath} fill={`url(#grad-${year})`} stroke="black" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Open folder (hidden by default) — black shadow folder behind, colored open folder in front -->
        <div class="folder-open absolute inset-0 flex items-end cursor-pointer" style="display:none;">
          <!-- Black shadow: closed shape, offset -->
          <svg width="64" height="55" viewBox="0 0 64 55" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute" style="bottom:4px; left:11px;">
            <path d={closedPath} fill="black" stroke="black" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <!-- Colored open folder on top -->
          <svg width="75" height="47" viewBox="0 0 75 47" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute" style="bottom:0; left:0;">
            <defs>
              <linearGradient id={`grad-open-${year}`} x1="37.1667" y1="2.5" x2="37.1667" y2="44.0833" gradientUnits="userSpaceOnUse">
                <stop stop-color={color}/>
                <stop offset="1" stop-color="white"/>
              </linearGradient>
            </defs>
            <path d={openPath} fill={`url(#grad-open-${year})`} stroke="black" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

      </div>

      {year}
    </button>
  ))}
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLElement>(".folder-btn[data-open]")) {
    const winId = btn.dataset.open!
    if (!winId) continue

    const win = document.getElementById(winId)
    const closedEl = btn.querySelector<HTMLElement>(".folder-closed")!
    const openEl = btn.querySelector<HTMLElement>(".folder-open")!

    btn.addEventListener("click", () => {
      closedEl.style.display = "none"
      openEl.style.display = "flex"
    })

    if (win) {
      new MutationObserver(() => {
        if (win.style.display === "none") {
          closedEl.style.display = ""
          openEl.style.display = "none"
        }
      }).observe(win, { attributes: true, attributeFilter: ["style"] })
    }
  }
</script>
