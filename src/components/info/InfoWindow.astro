---
// past years' overview archive
import { icons } from "../../assets/svgBank"
import { Medal, LayoutGrid, Paintbrush, Sparkles, HardDrive, MessageCircleHeart, FileText, ShieldUser, Camera, MousePointerClick, Images, X } from "@lucide/astro";
import { Picture } from 'astro:assets';

import {sh23Data} from "../../data/sh23Data.ts";
import {sh24Data} from "../../data/sh24Data.ts";
import {sh25Data} from "../../data/sh25Data.ts";
import {sh26Data} from "../../data/sh26Data.ts";
import {sh27Data} from "../../data/sh27Data.ts";

import SHLogo23 from "../../assets/logos/sh-23-logo.svg";
import SHLogo24 from "../../assets/logos/sh-24-logo.gif";
import SHLogo25 from "../../assets/logos/sh-25-logo.svg";
import SHLogo26 from "../../assets/logos/sh-26-logo.svg";
import question from "../../assets/logos/question.svg";

import { teamWindowConfig } from "../../data/teamWindowConfig";


const teamDataMap: Record<string, any> = {
  "win-2023": {year: 2023, data: sh23Data, team: teamWindowConfig[2023], logo: SHLogo23, color: "from-indigo-100 to-indigo-500"},
  "win-2024": {year: 2024, data: sh24Data, team: teamWindowConfig[2024], logo: SHLogo24, color: "from-violet-100 to-violet-600"},
  "win-2025": {year: 2025, data: sh25Data, team: teamWindowConfig[2025], logo: SHLogo25, color: "from-cyan-100 to-cyan-300"},
  "win-2026": {year: 2026, data: sh26Data, team: teamWindowConfig[2026], logo: SHLogo26, color: "from-rose-100 to-rose-900"},
  "win-2027": {year: 2027, data: sh27Data, team: teamWindowConfig[2027], logo: question, color: "from-gray-100 to-gray-900"},
};

interface Props {
  id?: string;
  title?: string;
  defaultZLayer?: number;
  customWindow?: string; // blank for default
}

interface TeamConfig {
  id: string,
  label: string,
  teamKey: string,
  title: string,
  x: number,
  y: number,
  width: string,
  color: string
}


const { id, title = "Info Window", customWindow="" } = Astro.props;

const yearData = teamDataMap[id || ""] || [];
---
<div class="">
  <!-- photo gallery button -->
  <div class="absolute">
    <div class="flex flex-col gap-2 items-center">
      <a href={yearData?.data.gallery} target="_blank" class="winner-btn group relative flex flex-col items-center justify-center">  
        <Images color="black" size={64}
        class="cursor-pointer dock-icon transition-all duration-200 ease-out group-hover:scale-110 group-hover:-translate-y-2"
        />
      </a>

      Photo Gallery
    </div>
  </div>

  <!-- winners button -->
  <div class="absolute right-5 top-48">
    <div class="flex flex-col gap-2 items-center">
      <button
      data-open={yearData?.year ? `winners-${yearData.year}` : ""}
      class="winner-btn group relative flex flex-col items-center justify-center"
      title="Winners"
      >
        <Medal color="black" fill="#FFEAA2" size={64}
          class="cursor-pointer dock-icon transition-all duration-200 ease-out group-hover:scale-110 group-hover:-translate-y-2"
        />
      </button>

      Winners
    </div>
  </div>

  <!-- project gallery -->
  <div class="absolute right-4">
    <div class="flex flex-col gap-2 items-center">
      <a
      href={yearData?.data.devpost} target=")_blank"
      class="winner-btn group relative flex flex-col items-center justify-center"
      title="Projects"
      >
        <LayoutGrid color="black" fill="#38cbe8" size={64}
          class="cursor-pointer dock-icon transition-all duration-200 ease-out group-hover:scale-110 group-hover:-translate-y-2"
        />
      </a>

      Projects
    </div>
  </div>
  

  
  <div class="select-none flex flex-col gap-3 justify-center items-center">
    <div class="justify-center items-center text-center">
      <h1 class="font-black font-sans text-2xl">{yearData?.data.name}</h1>
      <h1 class="font-black font-sans text-lg">{yearData?.data.slogan}</h1>
    </div>
    
    <Picture src={yearData?.logo} alt={`${yearData?.data.name} Logo`} class="border-[4px] border-primary rounded-xl w-36 h-36 bg-[#FBEAB0] object-contain" />

    {/* info */}
    <div id="about" class="text-center">
      <p>Date: {yearData?.data.date ?? "TBD"}</p>
      <p>Participants: {yearData?.data.participants ?? 0}</p>
      <p>Projects Submitted: {yearData?.data.projects ?? 0}</p>
      <!-- <p>Click to view the team members!</p> -->
    </div>
    
    {/* teams */}
    <ul class="flex">
      <div class="w-full flex items-end justify-center gap-6 px-8" style="bottom: 15px;">
        <div class="mx-22 flex flex-wrap gap-12 gap-y-3 justify-center items-center">
          {yearData?.team.map((team: TeamConfig) => (
            <button
                data-open={team.id}
                type="button"
                class="cursor-pointer team-btn group relative flex flex-col items-center justify-center"
            >
              {/* this took me so long to figure out why the colors would NOT work
                  but this span solution works but the major issue is that the icons will only fill the svgs with color 
                  ONLY once the first instance has been opened, which is so silly goofy :/
                  this lucide icon method works better LOL 
                  the same issue showed up with the svg def linear-gradients but the solution here was just
                  move the definitions to index.astro and that fixed everything
                  this was hours of my life gone -JL*/}

              {/* <span
                class="cursor-pointer dock-icon transition-all duration-200 ease-out group-hover:scale-110 group-hover:-translate-y-2"
                set:html={icons[team.teamKey]}
              /> */}

              {/* use a specific icon component for each team */}
              <div class="cursor-pointer dock-icon transition-all duration-200 ease-out group-hover:scale-110 group-hover:-translate-y-2">
                {team.teamKey === "directors" &&      <ShieldUser         color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "communications" && <MessageCircleHeart color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "logistics" &&      <FileText           color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "experience" &&     <Sparkles           color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "outreach" &&       <Paintbrush         color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "design" &&         <Paintbrush         color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "media" &&          <Camera             color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
                {team.teamKey === "webdev" &&         <HardDrive          color="black" fill={`url(#${team.color}-gradient)`} size={64} />}
              </div>

              {team.label}
            </button>
          ))}
        </div>

      </div>

    </ul>

    <div class="flex gap-8">
      <a href={yearData?.data.opening} target="_blank" class={`bg-linear-0 ${yearData?.color} rounded-2xl py-1 px-5 border-3 relative cursor-pointer transition hover:-translate-y-0.5`} style={{height:"fit-content"}}>Opening Ceremony</a>
      
      <div class="transition hover:-translate-y-0.5">
        <a href={yearData?.data.website} target="_blank" class={`text-xl bg-linear-0 ${yearData?.color} rounded-2xl py-1 px-5 border-3 relative cursor-pointer`}>Visit Site</a>
        <MousePointerClick class="relative left-27 bottom-3" fill="white" size={32} />
      </div>
      
      <a href={yearData?.data.closing} target="_blank" class={`bg-linear-0 ${yearData?.color} rounded-2xl py-1 px-5 border-3 relative cursor-pointer transition hover:-translate-y-0.5`} style={{height:"fit-content"}}>Closing Ceremony</a>
    </div>
    
    <slot />
  </div>
  
  
  <!-- make blank for custom windows -->
  {
    customWindow !== "" &&
    <div class="">
      <slot />
    </div>
  }

</div>
